{
    "name": "nails/module-find-replace",
    "description": "Consolidated find and replace for Nails applications",
    "homepage": "https://docs.nailsapp.co.uk/modules/find-replace",
    "license": "MIT",
    "minimum-stability": "dev",
    "prefer-stable": true,
    "require": {
        "php": ">=8.3",
        "nails/common": "dev-develop",
        "nails/module-console": "dev-develop",
        "nails/module-housekeeping": "dev-develop"
    },
    "require-dev": {
        "phpunit/phpunit": "^12.0",
        "phpstan/phpstan": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "Nails\\FindReplace\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\FindReplace\\": "tests/"
        }
    },
    "scripts": {
        "test": "./vendor/bin/phpunit",
        "analyse": "./vendor/bin/phpstan analyse -c .phpstan/config.neon"
    },
    "extra": {
        "nails": {
            "moduleName": "find-replace",
            "type": "module",
            "namespace": "Nails\\FindReplace\\"
        }
    }
}
