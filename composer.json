{
    "name": "nails/module-find-replace",
    "description": "Consolidated find and replace for Nails applications",
    "homepage": "https://docs.nailsapp.co.uk/modules/find-replace",
    "license": "MIT",
    "minimum-stability": "dev",
    "prefer-stable": true,
    "require": {
        "php": ">=8.3",
        "nails/common": "dev-feature/pre-new-admin",
        "nails/module-admin": "dev-feature/pre-new-admin",
        "nails/module-api": "dev-feature/pre-new-admin",
        "nails/module-console": "dev-feature/pre-new-admin",
        "nails/module-email": "dev-feature/pre-new-admin",
        "nails/module-housekeeping": "dev-feature/pre-new-admin",
        "nails/module-queue": "dev-feature/pre-new-admin"
    },
    "require-dev": {
        "phpunit/phpunit": "^12.0",
        "phpstan/phpstan": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "Nails\\FindReplace\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\FindReplace\\": "tests/"
        }
    },
    "scripts": {
        "test": "./vendor/bin/phpunit",
        "analyse": "./vendor/bin/phpstan analyse -c .phpstan/config.neon",
        "check-migrations": "php vendor/nails/common/scripts/check-migration-numbering.php"
    },
    "extra": {
        "nails": {
            "moduleName": "findReplace",
            "type": "module",
            "namespace": "Nails\\FindReplace\\",
            "data": {
                "nails/module-admin": {
                    "autoload": {
                        "assets": {
                            "js": [
                                "admin.min.js"
                            ],
                            "css": [
                                "admin.min.css"
                            ]
                        }
                    }
                },
                "nails/module-api": {
                    "namespace": "find-replace"
                }
            }
        }
    }
}
