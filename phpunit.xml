<?xml version="1.0" encoding="UTF-8"?>
<phpunit bootstrap="tests/bootstrap.php">
    <testsuites>
        <testsuite name="Unit">
            <directory suffix="Test.php">./tests</directory>
        </testsuite>
    </testsuites>
    <php>
        <env name="PRIVATE_KEY" value="testing" force="true"/>
        <env name="ENVIRONMENT" value="TESTING" force="true"/>
    </php>
</phpunit>
